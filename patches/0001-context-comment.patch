diff --git a/wind_input/crates/wind-coordinator/src/comment_context.rs b/wind_input/crates/wind-coordinator/src/comment_context.rs
new file mode 100644
index 0000000..8928061
--- /dev/null
+++ b/wind_input/crates/wind-coordinator/src/comment_context.rs
@@ -0,0 +1,127 @@
+//! 词桥语境规则：按**上文**给多义词挑释义。
+//!
+//! # 为什么需要它
+//!
+//! 注释词库是「词 → 一条注释」的静态映射，「米」永远显示 rice。但打完「三」再打
+//! `mi`，用户要的是 meter。词库本身没有能力表达「取决于上文」，所以规则单独成表。
+//!
+//! # 数据形态
+//!
+//! 与词桥的 `context.json` 同构：
+//!
+//! ```json
+//! {
+//!   "米": [
+//!     { "g": "meter", "t": ["一", "二", "三", "十"] },
+//!     { "g": "rice",  "t": ["吃", "买", "煮"] }
+//!   ]
+//! }
+//! ```
+//!
+//! `g` 是命中后要显示的释义，`t` 是触发词。判定方式是「上文里出现了某个触发词」。
+//!
+//! # 边界
+//!
+//! 规则只是**覆盖**，不是替代：查不到规则就回落到词库的原注释，所以规则表可以是稀疏的，
+//! 只写真正需要区分的那些词。
+
+use std::collections::HashMap;
+use std::path::Path;
+
+/// 一条语境规则。
+#[derive(Debug, Clone, serde::Deserialize)]
+pub struct CtxRule {
+    /// 命中后显示的释义。
+    #[serde(rename = "g")]
+    pub gloss: String,
+    /// 触发词：上文里出现任意一个即命中。
+    #[serde(rename = "t", default)]
+    pub triggers: Vec<String>,
+}
+
+/// 规则表：词 → 该词的若干条规则（按书写顺序，先命中先用）。
+pub type ContextTable = HashMap<String, Vec<CtxRule>>;
+
+/// 从 JSON 文件加载规则表。文件不存在或解析失败都返回空表。
+///
+/// 刻意不报错中断：语境规则是**锦上添花**的功能，文件写坏了不该让整个输入法起不来。
+/// 解析失败打一条 warn 就够——用户从日志能看到，而输入本身不受影响。
+pub fn load(path: &Path) -> ContextTable {
+    let Ok(raw) = std::fs::read_to_string(path) else {
+        return ContextTable::new();
+    };
+    match serde_json::from_str::<ContextTable>(&raw) {
+        Ok(t) => {
+            let rules: usize = t.values().map(Vec::len).sum();
+            tracing::info!(
+                "已加载语境规则 {} 词 / {} 条：{}",
+                t.len(),
+                rules,
+                path.display()
+            );
+            t
+        }
+        Err(e) => {
+            tracing::warn!("语境规则解析失败，已跳过 {}：{e}", path.display());
+            ContextTable::new()
+        }
+    }
+}
+
+/// 在规则表里为 `word` 挑一条与 `prev`（上文）匹配的释义。
+///
+/// 触发词判定用「包含」而不是「相等」：上文可能是「三米」「十三」这种带着别的字的片段，
+/// 严格相等会漏掉绝大多数真实场景。
+pub fn pick(table: &ContextTable, word: &str, prev: &str) -> Option<String> {
+    if prev.is_empty() {
+        return None;
+    }
+    for rule in table.get(word)? {
+        if rule.triggers.iter().any(|t| !t.is_empty() && prev.contains(t)) {
+            return Some(rule.gloss.clone());
+        }
+    }
+    None
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn table() -> ContextTable {
+        let mut t = ContextTable::new();
+        t.insert(
+            "米".into(),
+            vec![
+                CtxRule { gloss: "meter".into(), triggers: vec!["三".into(), "十".into()] },
+                CtxRule { gloss: "rice".into(), triggers: vec!["吃".into()] },
+            ],
+        );
+        t
+    }
+
+    #[test]
+    fn picks_by_prev() {
+        let t = table();
+        assert_eq!(pick(&t, "米", "三"), Some("meter".into()));
+        assert_eq!(pick(&t, "米", "吃"), Some("rice".into()));
+    }
+
+    #[test]
+    fn empty_prev_never_matches() {
+        assert_eq!(pick(&table(), "米", ""), None);
+    }
+
+    #[test]
+    fn unknown_word_or_prev_falls_through() {
+        let t = table();
+        assert_eq!(pick(&t, "面", "三"), None);
+        assert_eq!(pick(&t, "米", "买了"), None);
+    }
+
+    #[test]
+    fn prev_containing_trigger_counts() {
+        // 上文是「十三」也应命中「十」
+        assert_eq!(pick(&table(), "米", "十三"), Some("meter".into()));
+    }
+}
